{
  "name": "questing",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "scripts/dev",
    "app": "npm run start -w @questing/app --",
    "site": "npm run dev -w @questing/site",
    "api:generate": "npm run generate -w @questing/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm test -w @questing/e2e --"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
