#!/usr/bin/env python3
"""Draws the logo and every icon the app and website use: `scripts/make-icons`.

The logo is a map pin turned so that its point is the tail of a Q: Questing, and somewhere
to go. It's drawn on a 32-unit grid where the pin's round edges and its straight sides fall
on whole pixels at 32 pixels (and half pixels at 16), so the favicons stay sharp. The hole
is cut out, so whatever is behind the pin (the indigo, or Android's background) shows
through. Change the shapes and colours here, then run this again; it writes
apps/app/assets/logo/logo.svg too. Needs rsvg-convert (librsvg) and ImageMagick.
"""

import hashlib
import json
import shutil
import subprocess
import tempfile
from pathlib import Path

APP = Path(__file__).resolve().parent.parent / "apps" / "app"
IMAGES = APP / "assets" / "images"
LOGO = APP / "assets" / "logo"
WEB = APP / "public" / "icons"
MANIFEST = APP / "public" / "manifest.webmanifest"
VERSION_FILE = APP / "src" / "constants" / "icon-version.ts"

# The app's indigo (constants/theme.ts), as a gentle top-to-bottom gradient.
TOP = "#6366f1"
BOTTOM = "#4338ca"
# The page colours, behind the splash screen.
LIGHT_PAGE = "#f8fafc"
DARK_PAGE = "#0b1020"
# The rounded square's corners, in grid units: soft, but still a square.
CORNER = 7


def svg(*, background=True, corner=CORNER, scale=1.0, colour="#ffffff"):
    """The logo on a 32 × 32 grid.

    background: the indigo square (False for the mark alone, e.g. Android's foreground).
    corner: its corner radius; 0 for systems that round the corners themselves.
    scale: the mark's size around the middle; smaller where a system crops the icon.
    """
    square = (
        f'<rect width="32" height="32" rx="{corner}" fill="url(#indigo)"/>' if background else ""
    )
    # The pin: a circle of radius 9 around (15, 15) whose bottom-right quarter is a square
    # corner (softened a little), with a hole of radius 4. The mark spans 6 to 24, a point
    # left of and above the middle, which the heavier corner makes up for.
    return f"""<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
  <defs>
    <linearGradient id="indigo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="{TOP}"/>
      <stop offset="1" stop-color="{BOTTOM}"/>
    </linearGradient>
  </defs>
  {square}
  <g transform="translate(16 16) scale({scale}) translate(-16 -16)">
    <path d="M15 6A9 9 0 1 0 15 24H22A2 2 0 0 0 24 22V15A9 9 0 0 0 15 6ZM15 11A4 4 0 1 1 15 19A4 4 0 0 1 15 11Z"
      fill="{colour}" fill-rule="evenodd"/>
  </g>
</svg>
"""


def png(source, size, target):
    with tempfile.NamedTemporaryFile("w", suffix=".svg", delete=False) as file:
        file.write(source)
    target.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        ["rsvg-convert", "-w", str(size), "-h", str(size), "-o", str(target), file.name],
        check=True,
    )
    Path(file.name).unlink()
    if target.is_relative_to(APP):
        print(f"{target.relative_to(APP)} ({size}×{size})")


for tool in ("rsvg-convert", "magick"):
    if not shutil.which(tool):
        raise SystemExit(f"{tool} is needed: install librsvg and ImageMagick.")

LOGO_SVG = svg()
# Favicons: the same drawing, which is already made for small sizes.
SMALL = LOGO_SVG
# For iOS and maskable icons, which get their corners rounded (or cropped) for them.
SQUARE = svg(corner=0)
# Android crops icons to a circle (or other shapes) keeping the middle 61%; the pin's corner
# reaches 44% from the middle (diagonally) at full size.
ANDROID = 0.69
# Maskable web icons keep the middle 80% circle.
MASKABLE = 0.9

(LOGO / "logo.svg").write_text(LOGO_SVG)
print("assets/logo/logo.svg")

# The app (Expo): app.json points at these.
png(SQUARE, 1024, IMAGES / "icon.png")
png(svg(corner=0, scale=0), 1024, IMAGES / "android-icon-background.png")
png(svg(background=False, scale=ANDROID), 1024, IMAGES / "android-icon-foreground.png")
png(svg(background=False, scale=ANDROID), 1024, IMAGES / "android-icon-monochrome.png")
png(LOGO_SVG, 512, IMAGES / "splash-icon.png")
png(SMALL, 48, IMAGES / "favicon.png")

# The website: the manifest and +html.tsx point at these.
png(SQUARE, 180, WEB / "apple-touch-icon.png")
for size in (192, 512):
    png(LOGO_SVG, size, WEB / f"icon-{size}.png")
    png(svg(corner=0, scale=MASKABLE), size, WEB / f"icon-maskable-{size}.png")
(WEB / "favicon.svg").write_text(SMALL)
print("public/icons/favicon.svg")
png(SMALL, 32, WEB / "favicon-32.png")
with tempfile.TemporaryDirectory() as directory:
    sizes = []
    for size in (16, 32, 48):
        target = Path(directory) / f"{size}.png"
        png(SMALL, size, target)
        sizes.append(str(target))
    subprocess.run(["magick", *sizes, str(WEB / "favicon.ico")], check=True)
print("public/icons/favicon.ico (16, 32, 48)")

# The icons keep their names, and browsers and Cloudflare keep icons for hours, so their links
# carry a version that changes with the logo: a new logo is a new address, fetched afresh.
version = hashlib.sha256((LOGO_SVG + SMALL).encode()).hexdigest()[:8]
VERSION_FILE.write_text(
    "// Written by scripts/make-icons: changes with the logo, so its links skip old copies.\n"
    f"export const ICON_VERSION = '{version}';\n"
)
manifest = json.loads(MANIFEST.read_text())
for icon in manifest["icons"]:
    icon["src"] = icon["src"].split("?")[0] + f"?v={version}"
MANIFEST.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")
print(f"icon version {version}: src/constants/icon-version.ts, public/manifest.webmanifest")
